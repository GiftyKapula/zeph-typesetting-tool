        "      \"Children have the right to education, \" +",
        "      \"protection, and healthcare.\";",
        "  }",
        "  else if (category === \"responsibilities\") {",
        "    document.getElementById(\"output\").innerText =",
        "      \"Children have the responsibility to respect \" +",
        "      \"others and follow rules.\";",
        "  }",
        "  else {",
        "    document.getElementById(\"output\").innerText =",
        "      \"Please select a valid category.\";",
        "  }",
        "}"
      ]
    },
